generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleKind {
  cash
  credit
}

model Shop {
  id          String   @id @default(uuid())
  name        String   @unique
  phoneNumber String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers    Customer[]
  items        Item[]
  sales        Sale[]
  payments     Payment[]
  pendingSales PendingSale[]
  expenses     Expense[]
  ledgerEntries LedgerEntry[]
}

model Conversation {
  senderId  String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

// Receipt and response are committed in the same transaction as the ledger.
model InboundMessage {
  id           String   @id
  senderId     String
  text         String
  replyToId    String?
  outboundMessageId String? @unique
  sequence     BigInt   @unique @default(autoincrement())
  response     Json?
  createdAt    DateTime @default(now())
  deliveredAt  DateTime?
  attempts     Int      @default(0)
  nextAttemptAt DateTime @default(now())
  @@index([deliveredAt, nextAttemptAt])
}

model LedgerEntry {
  id              String @id @default(uuid())
  shopId          String
  sequence        BigInt @unique @default(autoincrement())
  data            Json
  currency        String
  revision        Int @default(1)
  sourceMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shop            Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  revisions       LedgerRevision[]
  @@unique([shopId, sourceMessageId])
  @@index([shopId, sequence])
}

model LedgerRevision {
  id              String @id @default(uuid())
  entryId         String
  revision        Int
  previous        Json
  replacement     Json
  sourceMessageId String?
  createdAt       DateTime @default(now())
  entry           LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  @@unique([entryId, revision])
}

model Expense {
  id          String   @id @default(uuid())
  shopId      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId, createdAt])
}

model Customer {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments Payment[]

  @@unique([shopId, normalizedName])
  @@index([shopId])
}

model Item {
  id             String   @id @default(uuid())
  shopId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@unique([shopId, normalizedName])
  @@index([shopId])
}

model Sale {
  id          String   @id @default(uuid())
  shopId      String
  itemId      String
  customerId  String?
  kind        SaleKind
  quantity    Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  dueDateText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item     Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, kind])
  @@index([customerId])
}

model Payment {
  id         String   @id @default(uuid())
  shopId     String
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([customerId])
}

model PendingSale {
  id          String   @id @default(uuid())
  shopId      String
  senderId    String   @unique
  kind        SaleKind
  item        String
  quantity    Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  customer    String?
  dueDateText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}
